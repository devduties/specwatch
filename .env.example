SPECWATCH_DATABASE_PATH=./data/specwatch.sqlite3
SPECWATCH_POLL_INTERVAL_SECONDS=300
SPECWATCH_MAX_SPEC_BYTES=2097152
# Optional comma-separated host allowlist for spec URLs, for example:
# SPECWATCH_ALLOWED_HOSTS=api.example.com,raw.githubusercontent.com

# Optional HookRelay event URL for newly detected breaking changes:
# SPECWATCH_ALERT_URL=http://127.0.0.1:8000/v1/endpoints/ENDPOINT_ID/events
# Optional Bearer key when the HookRelay API requires authentication:
# SPECWATCH_ALERT_API_KEY=replace-me
